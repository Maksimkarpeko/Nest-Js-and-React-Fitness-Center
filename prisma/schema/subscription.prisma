model Subscription {
  subscriptionId Int          @id @default(autoincrement()) @map("subscription_id")
  startDate      DateTime     @default(now()) @map("start_date")
  endDate        DateTime     @map("end_date")
  countVisit     Int          @map("count_visit")
  status         GlobalStatus @default(ACTIVE)
  tariff         Tariff       @relation(fields: [tariffId], references: [tariffId])
  tariffId       Int          @map("tariff_id")
  userId         Int          @map("user_id")
  user           User         @relation(fields: [userId], references: [userId])

  @@map("subscription")
}